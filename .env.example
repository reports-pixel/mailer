# Copy to .env for the Windows server, or add these as Environment Variables in the Vercel project.
# Secrets (never commit): SMTP_PASSWORD, TURSO_AUTH_TOKEN, ADMIN_PASSWORD, SESSION_SECRET.

# Sign-in
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign sessions (Vercel: required)
SESSION_SECRET=

# Turso database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Mail (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=
DEFAULT_CC=hr@example.com

# Windows server only
HOST=127.0.0.1
PORT=6001
LOCAL_ONLY=true
EMPLOYEE_API_URL=http://your-office-server:8080/v1/api/employee/email-user?p_E_COMP=FP&p_E_CODE=00000
PDF_FOLDER=C:\path\to\pdfs
