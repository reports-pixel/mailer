{
  "name": "kg-mail-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "KG employee PDF mailer: React page + Node.js server in one application.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch-path=server server/index.js --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "typecheck": "tsc --noEmit",
    "sync-users": "node --env-file-if-exists=.env scripts/sync-users.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.65.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
